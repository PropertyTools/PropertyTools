<Window x:Class="DataGridDemo.CloseWindowOnCellClickExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:dataGridDemo="clr-namespace:DataGridDemo"
        Title="Close window on cell click" Height="450" Width="900">
    <Window.DataContext>
        <dataGridDemo:ExampleViewModel/>
    </Window.DataContext>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap"
                   Text="Click any cell to close this window while the mouse button is being processed. This used to throw an InvalidOperationException because the DataGrid was no longer connected to a PresentationSource (#510)."/>
        <p:DataGrid ItemsSource="{Binding ItemsSource}" PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
            <p:DataGrid.ColumnDefinitions>
                <p:ColumnDefinition PropertyName="String" Width="2*"  Header="string"/>
                <p:ColumnDefinition PropertyName="Integer" Width="1*" HorizontalAlignment="Center" Header="integer"/>
                <p:ColumnDefinition PropertyName="Boolean" Width="1*" HorizontalAlignment="Center" Header="boolean"/>
                <p:ColumnDefinition PropertyName="Fruit" Width="1*" Header="enum"/>
                <p:ColumnDefinition PropertyName="Selector" Width="1*" Header="selector"/>
                <p:ColumnDefinition PropertyName="Color" Width="1*" Header="Color"/>
            </p:DataGrid.ColumnDefinitions>
        </p:DataGrid>
    </DockPanel>
</Window>
