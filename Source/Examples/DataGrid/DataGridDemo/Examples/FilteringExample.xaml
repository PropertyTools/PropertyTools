<Window x:Class="DataGridDemo.FilteringExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:local="clr-namespace:DataGridDemo"
        Title="Filtering Example" Height="600" Width="1000">
    <Window.DataContext>
        <local:FilteringViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Filter Controls -->
        <GroupBox Header="Filters" Padding="10" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Search Text Filter -->
                <TextBlock Text="Search:" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Grid.Column="1" VerticalAlignment="Center"/>
                
                <!-- Fruit Filter -->
                <TextBlock Text="Fruit:" VerticalAlignment="Center" Grid.Column="3" Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding FruitFilterOptions}" 
                          SelectedItem="{Binding SelectedFruitFilter}"
                          Grid.Column="4" VerticalAlignment="Center"/>
                
                <!-- Boolean Filter -->
                <CheckBox Content="Boolean Only" 
                          IsChecked="{Binding FilterByBoolean}"
                          Grid.Column="6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <!-- Clear Filters Button -->
                <Button Content="Clear Filters" 
                        Command="{Binding ClearFiltersCommand}"
                        Grid.Column="8" Padding="10,5" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
        
        <!-- DataGrid bound to FilteredItems which is the ICollectionView from CollectionViewSource -->
        <!-- This enables automatic filtering without modifying the underlying collection -->
        <p:DataGrid ItemsSource="{Binding FilteredItems}" Grid.Row="1" Margin="0,10,0,0">
            <p:DataGrid.ColumnDefinitions>
                <p:ColumnDefinition PropertyName="String" Width="2*" Header="Name"/>
                <p:ColumnDefinition PropertyName="Integer" Width="1*" HorizontalAlignment="Center" Header="Integer"/>
                <p:ColumnDefinition PropertyName="Boolean" Width="1*" HorizontalAlignment="Center" Header="Boolean"/>
                <p:ColumnDefinition PropertyName="Fruit" Width="1*" Header="Fruit"/>
                <p:ColumnDefinition PropertyName="DateTime" Width="2*" Header="Date"/>
                <p:ColumnDefinition PropertyName="Color" Width="1*" Header="Color"/>
            </p:DataGrid.ColumnDefinitions>
        </p:DataGrid>
    </Grid>
</Window>
