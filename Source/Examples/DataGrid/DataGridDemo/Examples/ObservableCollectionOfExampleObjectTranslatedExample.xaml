<Window x:Class="DataGridDemo.ObservableCollectionOfExampleObjectTranslatedExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:dataGridDemo="clr-namespace:DataGridDemo"
        xmlns:operators="clr-namespace:DataGridDemo.Operators"
        Title="ObservableCollection&lt;ExampleObject&gt; (Translated)" Height="450" Width="900">
    <Window.Resources>
        <operators:CustomLocalizableOperator x:Key="CustomLocalizableOperator" />
    </Window.Resources>
    <Window.DataContext>
        <dataGridDemo:ExampleViewModel/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ItemsSource">
                <MenuItem Header="Clear" Command="{Binding ClearCommand}"/>
                <MenuItem Header="Reset" Command="{Binding ResetCommand}"/>
            </MenuItem>
        </Menu>
        <p:DataGrid ItemsSource="{Binding ItemsSource}" CellDefinitionFactory="{Binding CellDefinitionFactory}"
                    LocalizableOperator="{StaticResource CustomLocalizableOperator}" />
    </DockPanel>
</Window>
