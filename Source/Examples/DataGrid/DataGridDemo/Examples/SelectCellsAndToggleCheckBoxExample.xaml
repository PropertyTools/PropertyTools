<Window x:Class="DataGridDemo.SelectCellsAndToggleCheckBoxExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        Title="Select cells and toggle check box" Height="300" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="8"
                   TextWrapping="Wrap"
                   Text="Select a row and click the check box cell. The &quot;String&quot; column reflects the current Boolean value." />
        <p:DataGrid Grid.Row="1"
                    Margin="8"
                    ItemsSource="{Binding ItemsSource}" />
    </Grid>
</Window>
