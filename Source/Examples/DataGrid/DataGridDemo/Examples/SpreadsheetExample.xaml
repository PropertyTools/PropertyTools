<Window x:Class="DataGridDemo.SpreadsheetExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        Title="Spreadsheet" Height="450" Width="900">
    <Grid>
        <p:DataGrid ItemsSource="{Binding Spreadsheet}"
            RowHeadersSource="{Binding RowHeadersItemsSource}"
            ColumnHeadersSource="{Binding ColumnHeadersItemsSource}"
            CreateColumnHeader="{Binding CreateColumnHeader}">
        </p:DataGrid>
    </Grid>
</Window>
