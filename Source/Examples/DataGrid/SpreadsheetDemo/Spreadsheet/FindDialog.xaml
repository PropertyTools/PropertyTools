<Window x:Class="SpreadsheetDemo.Spreadsheet.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="12">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Find what:" Grid.Column="0" VerticalAlignment="Center" />
            <TextBox x:Name="FindTextBox" Grid.Column="1" Margin="0,2" />
        </Grid>
        <CheckBox x:Name="MatchCaseCheckBox" Content="Match case" Margin="0,0,0,8" />
        <TextBlock x:Name="StatusTextBlock" Margin="0,0,0,8" Foreground="Gray" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Find Next" Width="90" Click="FindNext_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
