<Window x:Class="DemoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DemoLauncher"
        Title="PropertyTools Demo Launcher" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:TagsToStringConverter x:Key="TagsToStringConverter"/>
        <local:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <local:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter"/>
        <Style TargetType="TextBlock" x:Key="TitleStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DescriptionStyle">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TagStyle">
            <Setter Property="Foreground" Value="DarkBlue"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="PropertyTools Examples" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Filter TextBox -->
        <TextBox Grid.Row="1" 
                 x:Name="FilterTextBox"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="Black"/>
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Foreground" Value="Gray"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        
        <!-- Filter hint -->
        <TextBlock Grid.Row="1" 
                   Text="Type to filter by title, description, or tags..."
                   Foreground="Gray"
                   Margin="5,0,0,10"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=FilterTextBox, Path=Text}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusText}"
                   Foreground="Gray"
                   Margin="0,0,0,10"/>

        <!-- Examples ListBox -->
        <ListBox Grid.Row="3" 
                 x:Name="ExamplesListBox"
                 ItemsSource="{Binding FilteredExamples}"
                 SelectedItem="{Binding SelectedExample}"
                 SelectionMode="Single"
                 MouseDoubleClick="ExamplesListBox_MouseDoubleClick"
                 KeyDown="ExamplesListBox_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleStyle}"/>
                        <TextBlock Text="{Binding AssemblyName}" 
                                   FontSize="11" 
                                   Foreground="DarkGreen" 
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Description}" 
                                   Style="{StaticResource DescriptionStyle}"
                                   Visibility="{Binding Description, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Tags, Converter={StaticResource TagsToStringConverter}}" 
                                   Style="{StaticResource TagStyle}"
                                   Visibility="{Binding Tags, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="Launch Example" 
                    Width="120" 
                    Height="30" 
                    Click="LaunchButton_Click" 
                    IsEnabled="{Binding SelectedExample, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="Refresh" 
                    Width="80" 
                    Height="30" 
                    Click="RefreshButton_Click" 
                    Margin="10,0,0,0"/>
            <Button Content="Close" 
                    Width="80" 
                    Height="30" 
                    Click="CloseButton_Click" 
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
