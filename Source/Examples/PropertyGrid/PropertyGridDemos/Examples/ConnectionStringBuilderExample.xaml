<Window x:Class="PropertyGridDemos.ConnectionStringBuilderExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:d="clr-namespace:PropertyGridDemos"
        Title="ConnectionStringBuilder PropertyGrid (issue #288)" Height="600" Width="900">
    <Window.DataContext>
        <d:ConnectionStringBuilderExampleViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            Demonstrates issue #288 (fixed): PropertyGrid now works correctly when bound to a class
            derived from DbConnectionStringBuilder. Previously: bool properties showed indeterminate
            checkboxes, enum properties showed no selection, and byte[] caused a StringFormat exception.
        </TextBlock>

        <p:PropertyGrid Grid.Row="1" SelectedObject="{Binding Builder}"/>
    </Grid>
</Window>
