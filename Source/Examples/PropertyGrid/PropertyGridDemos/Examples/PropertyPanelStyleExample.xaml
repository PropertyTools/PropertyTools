<Window x:Class="PropertyGridDemos.PropertyPanelStyleExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pt="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:d="clr-namespace:PropertyGridDemos"
        Title="PropertyPanelStyle and LabelPanelStyle (issue #275)" Height="550" Width="1000">
    <Window.DataContext>
        <d:PropertyPanelStyleExampleViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10" Background="LightYellow">
            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Margin="5">
                PropertyPanelStyle and LabelPanelStyle Example (issue #275)
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="5">
                The left PropertyGrid uses no custom styles (default appearance).
                The right PropertyGrid uses PropertyPanelStyle and LabelPanelStyle to simulate a dark theme.
                PropertyPanelStyle targets the Grid wrapping each property row; LabelPanelStyle targets the DockPanel containing the label.
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Default appearance (no custom styles) -->
            <DockPanel Grid.Column="0" Margin="0 0 5 0">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0 0 0 4">
                    Default (no PropertyPanelStyle / LabelPanelStyle)
                </TextBlock>
                <pt:PropertyGrid SelectedObject="{Binding Item}" VerticalPropertySpacing="0"/>
            </DockPanel>

            <!-- Dark theme via PropertyPanelStyle and LabelPanelStyle -->
            <DockPanel Grid.Column="1" Margin="5 0 0 0" Background="#1E1E1E">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0 0 0 4" Foreground="White">
                    Dark theme (PropertyPanelStyle + LabelPanelStyle)
                </TextBlock>
                <pt:PropertyGrid SelectedObject="{Binding Item}" VerticalPropertySpacing="0">
                    <pt:PropertyGrid.PropertyPanelStyle>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="#2D2D2D"/>
                        </Style>
                    </pt:PropertyGrid.PropertyPanelStyle>
                    <pt:PropertyGrid.LabelPanelStyle>
                        <Style TargetType="DockPanel">
                            <Setter Property="Background" Value="#252525"/>
                        </Style>
                    </pt:PropertyGrid.LabelPanelStyle>
                </pt:PropertyGrid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
