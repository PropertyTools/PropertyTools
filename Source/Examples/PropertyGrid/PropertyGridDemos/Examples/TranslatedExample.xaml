<Window x:Class="PropertyGridDemos.TranslatedExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
        xmlns:d="clr-namespace:PropertyGridDemos" xmlns:operators="clr-namespace:PropertyGridDemos.Operators"
        Title="Translated PropertyGrid" Height="450" Width="900">
    <Window.Resources>
        <operators:CustomLocalizableOperator x:Key="CustomLocalizableOperator" />
    </Window.Resources>
    <Window.DataContext>
        <d:TranslatedExampleViewModel/>
    </Window.DataContext>
    <Grid Margin="4">
        <p:PropertyGrid SelectedObject="{Binding SelectedObject}"  LocalizableOperator="{StaticResource CustomLocalizableOperator}">
        </p:PropertyGrid>
    </Grid>
</Window>
