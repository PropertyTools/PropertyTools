<Window x:Class="TreeListBoxDemo.Examples.CutPasteExample.CutPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreeListBoxDemo.Examples.CutPasteExample"
        xmlns:pt="http://propertytools.org/wpf"
        Title="Cut/Paste + IsExpanded Example (Issue #292)" Height="650" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:CutPasteNode}">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Background="LightYellow" Padding="10" TextWrapping="Wrap">
            <Bold>Issue #292 repro steps:</Bold> 1) Reset Scenario, 2) Select Node 1 and expand it to show Node 2, 3) Click Cut, 4) Select the parent and click Paste.
            The pasted node intentionally preserves IsExpanded=true to reproduce the original crash condition.
        </TextBlock>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Reset Scenario" Click="ResetScenarioClick" />
            <Separator />
            <Button Content="Add Root" Click="AddRootClick" />
            <Button Content="Add Child" Click="AddChildClick" />
            <Separator />
            <Button Content="Cut" Click="CutClick" />
            <Button Content="Paste" Click="PasteClick" />
        </ToolBar>
        <pt:TreeListBox x:Name="tree1"
                        Margin="8"
                        Indentation="14"
                        BorderThickness="0"
                        HierarchySource="{Binding RootNodes}"
                        ChildrenPath="Children"
                        IsExpandedPath="IsExpanded" />
    </DockPanel>
</Window>
