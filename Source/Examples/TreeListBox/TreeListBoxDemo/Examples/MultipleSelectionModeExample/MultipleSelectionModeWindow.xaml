<Window x:Class="TreeListBoxDemo.Examples.MultipleSelectionModeExample.MultipleSelectionModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreeListBoxDemo"
        xmlns:pt="http://propertytools.org/wpf"
        Title="Multiple Selection Mode Example" Height="800" Width="600">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:NodeViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/folder.png" Margin="0 0 4 0"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Background="LightBlue" Padding="10" TextWrapping="Wrap">
            <Bold>Multiple Selection Mode Demo:</Bold> This example demonstrates the TreeListBox with SelectionMode set to Extended (allows multiple selections).
            Use Ctrl+Click to select multiple items, or Shift+Click to select a range. Try changing the HierarchySource to see proper handling of multiple selections.
        </TextBlock>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="SelectedItems: "/>
            <TextBlock Text="{Binding SelectedItems.Count, ElementName=tree1}"/>
            <Separator/>
            <TextBlock Text="SelectionMode: Extended"/>
            <Separator/>
            <Button Content="Load New Data" Click="LoadNewDataClick" Margin="5,0"/>
            <Button Content="Clear Selection" Click="ClearSelectionClick" Margin="5,0"/>
            <Button Content="Select First 3" Click="SelectFirstThreeClick" Margin="5,0"/>
        </StatusBar>
        <pt:TreeListBox 
            x:Name="tree1" 
            SelectionMode="Extended"
            Indentation="12" 
            HierarchySource="{Binding Roots}"
            BorderThickness="0"/>
    </DockPanel>
</Window>
