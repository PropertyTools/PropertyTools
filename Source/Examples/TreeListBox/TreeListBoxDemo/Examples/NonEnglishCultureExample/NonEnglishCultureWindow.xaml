<Window x:Class="TreeListBoxDemo.Examples.NonEnglishCultureExample.NonEnglishCultureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreeListBoxDemo"
        xmlns:pt="http://propertytools.org/wpf"
        Title="Non-English Culture Example (Issues #38 &amp; #142)" Height="600" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:NodeViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/folder.png" Margin="0 0 4 0"/>
                <pt:EditableTextBlock Grid.Column="1" Text="{Binding Name}" IsEditing="{Binding IsEditing}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Background="LightYellow" Padding="10" TextWrapping="Wrap">
            <Bold>Non-English Culture Fix (Issues #38 &amp; #142):</Bold>
            This window sets the thread UI culture to <Bold>de-DE (German)</Bold> before loading the
            TreeListBox, simulating a non-English Windows installation. The fix in
            <Italic>TreeListBox.InsertItem</Italic> detects the WPF virtualization
            ArgumentException using non-localized signals (<Italic>TargetSite.Name</Italic> and
            <Italic>StackTrace</Italic>) instead of comparing the localized exception message,
            so it works correctly regardless of the system language. Expand and collapse
            nodes freely — there should be no unhandled exceptions.
        </TextBlock>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="UI Culture: de-DE (German)  |  SelectedItem: "/>
            <TextBlock Text="{Binding SelectedItem.Name, ElementName=tree1}"/>
        </StatusBar>

        <pt:TreeListBox
            x:Name="tree1"
            Indentation="12"
            HierarchySource="{Binding Root}"
            BorderThickness="1"/>
    </DockPanel>
</Window>
