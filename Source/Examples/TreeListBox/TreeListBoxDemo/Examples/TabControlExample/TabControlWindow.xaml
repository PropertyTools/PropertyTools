<Window x:Class="TreeListBoxDemo.Examples.TabControlExample.TabControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreeListBoxDemo"
        xmlns:pt="http://propertytools.org/wpf"
        Title="TabControl Example - Reproducing Issue #312" Height="600" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:NodeViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/folder.png" Margin="0 0 4 0"/>
                <pt:EditableTextBlock Grid.Column="1" Text="{Binding Name}" IsEditing="{Binding IsEditing}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Background="LightYellow" Padding="10" TextWrapping="Wrap">
            <Bold>Issue #312 Reproduction:</Bold> This example demonstrates the TreeListBox crash when used in a TabControl.
            The application starts on the "Empty Tab". Click on the "TreeListBox Tab" to switch tabs and trigger the crash
            (NullReferenceException at TreeListBox.cs line 760).
        </TextBlock>
        
        <TabControl>
            <!-- Empty tab - starts selected -->
            <TabItem Header="Empty Tab">
                <Grid>
                    <TextBlock Text="This tab is empty. Switch to the 'TreeListBox Tab' to trigger the crash." 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>
            
            <!-- Tab with TreeListBox - switching to this tab causes the crash -->
            <TabItem Header="TreeListBox Tab">
                <DockPanel>
                    <StatusBar DockPanel.Dock="Bottom">
                        <TextBlock Text="SelectedItem: "/>
                        <TextBlock Text="{Binding SelectedItem.Name, ElementName=tree1}"/>
                    </StatusBar>
                    
                    <pt:TreeListBox 
                        x:Name="tree1" 
                        Indentation="12" 
                        HierarchySource="{Binding Root}"
                        BorderThickness="1"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
